# ============================================================
#  环境变量模板
#  用法：复制本文件为 .env，填入真实值。
#  .env 已被 .gitignore 排除，不会进入 Git 仓库。
# ============================================================

# ---------- Django ----------
# 生产环境请替换为随机字符串，例如：
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=please-change-me
# 本地开发填 1；上线部署请填 0
DJANGO_DEBUG=1
# 允许访问的域名，逗号分隔；本地开发可用 *
DJANGO_ALLOWED_HOSTS=*

# ---------- 数据库（MySQL） ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=project_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# ---------- 管理员口令 ----------
# 管理后台接口校验用
ADMIN_KEY=your_admin_key
# 用户自助提权为管理员的激活码；留空则关闭该入口
ADMIN_ACTIVATE_CODE=

# ---------- 大模型 API ----------
# 推荐链路与审核链路的 base_url / model / api_key 可在管理后台在线配置，
# 也可直接写入数据库表 ApiConfig / AuditApiConfig。
# 支持任意 OpenAI 兼容端点，例如：
#   硅基流动   https://api.siliconflow.cn/v1
#   DeepSeek  https://api.deepseek.com/v1
#   Ollama    http://localhost:11434/v1
LLM_DISABLE_PROXY=0

# ---------- RAG / 向量检索 ----------
# 留空则依次回退到 downloaded_models/ 与 backend_django/models/
BGE_SMALL_ZH_MODEL_DIR=
BGE_HF_CACHE_DIR=
HF_ENDPOINT=https://hf-mirror.com
RAG_SIMILARITY_THRESHOLD=0.35

# ---------- 大模型请求超时与重试 ----------
API_REQUEST_TIMEOUT_SECONDS=65
API_RETRY_ON_TRANSIENT=1
API_RETRY_BACKOFF_SECONDS=0.6
