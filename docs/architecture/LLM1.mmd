flowchart TD
    %% ========== 样式定义 ==========
    classDef userStyle fill:#c8e6c9,stroke:#2e7d32,color:#1b5e20
    classDef frontStyle fill:#bbdefb,stroke:#1565c0,color:#0d47a1
    classDef backStyle fill:#ffe0b2,stroke:#e65100,color:#bf360c
    classDef llmStyle fill:#e1bee7,stroke:#6a1b9a,color:#4a148c
    classDef auditStyle fill:#ffcdd2,stroke:#b71c1c,color:#7f0000
    classDef dbStyle fill:#cfd8dc,stroke:#37474f,color:#263238
    classDef endStyle fill:#f3e5f5,stroke:#4a148c,color:#4a148c

    %% ========== 用户泳道 ==========
    subgraph User["👤 用户"]
        U1(用户输入需求):::userStyle
        U2{用户操作}:::userStyle
        Forum((转发至论坛)):::endStyle
    end

    %% ========== 前端泳道 ==========
    subgraph Frontend["🖥️ 前端"]
        F1[封装输入内容和会话标识<br>发送给后端]:::frontStyle
        F2[展示生成内容给用户<br>若审核不可用则标注]:::frontStyle
    end

    %% ========== 后端泳道 ==========
    subgraph Backend["⚙️ 后端"]
        B1[将用户输入传输给大模型解析]:::backStyle
        B2[在本地知识库<br>查找候选硬件集合]:::backStyle
        B3[结构化候选集合<br>与预设提示词拼接]:::backStyle
        B4[将拼接提示词发送给大模型<br>生成初步推荐方案]:::backStyle
        B5[(将生成结果储存至数据库)]:::dbStyle
        B6[将生成内容发送至审核系统]:::backStyle
        B7[将问题和生成内容<br>传回大模型重新生成]:::backStyle
    end

    %% ========== 大模型泳道 ==========
    subgraph LLM["🧠 大模型"]
        A1[解析用户输入<br>返回解析结果]:::llmStyle
        A2[生成初步推荐方案]:::llmStyle
    end

    %% ========== 审核系统泳道 ==========
    subgraph Audit["🛡️ 审核系统"]
        M1{审核}:::auditStyle
        M2[通过]:::auditStyle
        M3[失败]:::auditStyle
        M4[审核系统不可用]:::auditStyle
    end

    %% ========== 流程连接 ==========
    U1 --> F1
    F1 --> B1
    B1 --> A1
    A1 --> B2
    B2 --> B3
    B3 --> B4
    B4 --> A2
    A2 --> B5
    B5 --> B6
    B6 --> M1

    M1 -->|通过| M2
    M1 -->|失败| M3
    M1 -->|不可用| M4

    M2 --> F2
    M4 -->|标注不可用后展示| F2

    M3 --> B7
    B7 -->|重新生成| B4

    F2 --> U2
    U2 -->|继续对话| U1
    U2 -->|转发至论坛| Forum